# Server port for unified Next.js + WebSocket server
PORT=3005

# Local zero-config SQLite database (auto-created on startup or db:migrate)
DATABASE_URL="file:./data/app.db"

# Optional PostgreSQL connection string for production / Docker Compose
POSTGRES_URL="postgresql://postgres:postgres@localhost:5432/syncchat"

# Public App URL
NEXT_PUBLIC_APP_URL="http://localhost:3005"

# Signed HMAC-SHA256 Webhooks (TraceLab / external receiver)
WEBHOOK_URL=""
WEBHOOK_SECRET="portfolio-ecosystem-dev-secret"
